{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "npm install*": "deny",
      "npm update*": "deny"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**",
      "sources/**",
      "info/**",
      "tools/**",
      "*.pdf",
      "*.docx",
      "*.png",
      "*.jpg",
      "*.jpeg"
    ]
  }
}
